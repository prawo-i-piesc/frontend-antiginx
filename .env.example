# Example environment variables for frontend-antiginx
# Copy this file to .env.local and customize values for your environment.

# Address the frontend server uses to reach the backend when proxying /api.
# Read at runtime and never exposed to the browser, so it may point at an
# address only reachable from inside the network (a Kubernetes Service name,
# a compose service name).
BACKEND_URL=http://localhost:4000

# Example (Kubernetes): BACKEND_URL=http://backend-antiginx:4000

# Set to "true" only where a proxy we control (an ingress) sits in front of
# this app and overwrites the X-Forwarded-* headers. The backend then receives
# the real client address, which the per-IP rate limits and the session record
# depend on. Leave it unset anywhere a browser can reach this app directly —
# otherwise anyone could claim any address.
TRUST_PROXY_HEADERS=
